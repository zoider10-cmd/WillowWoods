# Checked against the remake actors (Banc/IceCavern, DefaultDungeonRoomIndex) and the Trophy Tom
# walkthrough (docs/dungeon-logic/ice-cavern.md). The route is the N64 one: Freezards (room 1),
# the scythe room silver rupees open the map room, red ice walls lead to the compass room and to the
# push block room, whose silver rupees open the way to a last red ice wall, the White Wolfos and
# Sheik. The remake has no heart piece, no freestanding rupees or hearts and no Map Room frozen pot.
[
    {
        "region_name": "Ice Cavern Beginning",
        "dungeon": "Ice Cavern",
        "locations":{
            "Ice Cavern Frozen Blue Rupee": "
                Blue_Fire or logic_ice_frozen_rupee or
                (logic_boomerang_boulders and can_use(Boomerang))"
        },
        "exits": {
            "ZF Ice Ledge": "True",
            # Freezards are immune to Kokiri Sword. It would take a lot of sticks.
            "Ice Cavern Spinning Scythe Room": "here(is_adult or has_explosives or can_use(Dins_Fire))",
            "Farores Wind Warp": "can_use(Farores_Wind)"
        }
    },
    {
        "region_name": "Ice Cavern Spinning Scythe Room",
        "dungeon": "Ice Cavern",
        "locations": {
            "Ice Cavern Hall Pot 1": "True",
            "Ice Cavern Hall Pot 2": "True",
            "Ice Cavern Spinning Scythe Pot 1": "True",
            "Ice Cavern Spinning Scythe Pot 2": "True",
            "Ice Cavern Spinning Scythe Pot 3": "True",
            "Ice Cavern Spinning Scythe Flying Pot":  "True",
            "Ice Cavern Spinning Scythe Silver Rupee Icicles": "True",
            "Ice Cavern Spinning Scythe Silver Rupee Center Left": "True",
            "Ice Cavern Spinning Scythe Silver Rupee Center Back": "True",
            "Ice Cavern Spinning Scythe Silver Rupee Center Right": "True",
            "Ice Cavern Spinning Scythe Silver Rupee Ledge": "is_adult",
            "Ice Cavern GS Spinning Scythe Room": "can_use(Hookshot) or can_use(Boomerang)"
        },
        "exits": {
            "Ice Cavern Map Room": "is_adult and (Silver_Rupee_Ice_Cavern_Spinning_Scythe, 5)",
            "Ice Cavern Behind Ice Walls": "here(Blue_Fire)"
        }
    },
    {
        "region_name": "Ice Cavern Map Room",
        "dungeon": "Ice Cavern",
        "locations": {
            "Ice Cavern Map Chest": "Blue_Fire",
            "Ice Cavern Map Room Recovery Heart 1": "True",
            "Ice Cavern Map Room Recovery Heart 2": "True",
            "Ice Cavern Map Room Recovery Heart 3": "True",
            "Ice Cavern Frozen Pot": "Blue_Fire or logic_ice_frozen_pot",
            "Blue Fire": "has_bottle"
        }
    },
    {
        "region_name": "Ice Cavern Behind Ice Walls",
        "dungeon": "Ice Cavern",
        "locations": {
            "Ice Cavern Compass Chest": "True",
            "Ice Cavern Freestanding PoH": "True",
            "Ice Cavern Push Block Room Chest": "can_play(Song_of_Time)",
            "Ice Cavern Push Block Room Red Rupee 1": "can_play(Song_of_Time) or can_use(Boomerang)",
            "Ice Cavern Push Block Room Red Rupee 2": "can_play(Song_of_Time) or can_use(Boomerang)",
            "Ice Cavern Push Block Room Red Rupee 3": "can_play(Song_of_Time) or can_use(Boomerang)",
            "Ice Cavern Push Block Silver Rupee Back Left": "True",
            "Ice Cavern Push Block Silver Rupee Back Center": "True",
            "Ice Cavern Push Block Silver Rupee Front Center": "True",
            # Frozen in red ice (Obj_RedIce_A_09).
            "Ice Cavern Push Block Silver Rupee Red Ice": "Blue_Fire",
            "Ice Cavern Push Block Silver Rupee Front Left": "True",
            "Ice Cavern GS Heart Piece Room": "can_use(Hookshot) or can_use(Boomerang)",
            "Ice Cavern GS Push Block Room": "
                can_use(Hookshot) or can_use(Boomerang) or
                (logic_ice_block_gs and can_use(Hover_Boots))"
        },
        "exits": {
            # The silver rupees open the way to room 9, where red ice (Obj_RedIce_A_04) closes the
            # White Wolfos door.
            "Ice Cavern End": "(Silver_Rupee_Ice_Cavern_Push_Block, 5) and Blue_Fire"
        }
    },
    {
        "region_name": "Ice Cavern End",
        "dungeon": "Ice Cavern",
        # Rooms 9 to 11. The last room also has a back door to Zora's Fountain through water, taken
