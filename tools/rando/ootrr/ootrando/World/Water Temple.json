# Water Temple, rebuilt from a remake 100% walkthrough (docs/dungeon-logic/water-temple.md).
# The remake has 4 small keys (Torches, Dragon, Compass Room and Central Bow Target chests)
# and 4 locked doors, opened in this order: the central pillar door on 1F, the pink pillar
# door on 2F west (the room that raises the water to 3F), the 3F door to the falling
# platforms and Dark Link, and the 1F north door to the Boss Key. water_keys(n) keeps one
# key of slack when keys are shuffled, because the 3F door can take a key on the first visit.
[
    {
        "region_name": "Water Temple Lobby",
        "dungeon": "Water Temple",
        "exits": {
            "Lake Hylia": "True",
            "Water Temple Dive": "
                is_adult and Iron_Boots and (Zora_Tunic or logic_fewer_tunic_requirements)",
            # The boss door hangs above the 3F water line, so the water must be raised again
            # once it was lowered.
            "Water Temple Before Boss": "can_use(Longshot) and Raise_Water_Level",
            "Farores Wind Warp": "can_use(Farores_Wind)"
        }
    },
    {
        "region_name": "Water Temple Before Boss",
        "dungeon": "Water Temple",
        "savewarp": "Lake Hylia -> Water Temple Lobby",
        "locations": {
            "Water Temple Near Boss Pot 1": "True",
            "Water Temple Near Boss Pot 2": "True",
            "Fairy Pot": "has_bottle"
        },
        "exits": {
            "Morpha Boss Room": "Boss_Key_Water_Temple"
        }
    },
    {
        "region_name": "Water Temple Dive",
        "dungeon": "Water Temple",
        "locations": {
            # On a 3F ledge after Ruto. It is taken before the first lowering, but once the
            # water is down only the 3F triforce brings it back.
            "Water Temple Map Chest": "Raise_Water_Level"
        },
        "exits": {
            "Water Temple Lowered Water Levels": "can_play(Zeldas_Lullaby)"
        }
    },
    {
        "region_name": "Water Temple Lowered Water Levels",
        "dungeon": "Water Temple",
        "locations": {
            # Arrows shot through the lit candle light the two braziers.
            "Water Temple Torches Chest": "Bow or can_use(Dins_Fire)",
            "Water Temple L1 Torch Pot 1": "True",
            "Water Temple L1 Torch Pot 2": "True"
        },
        "exits": {
            # Bomb the rocks of the south room, then sink and hookshot along the channel.
            "Water Temple South Basement": "has_explosives and can_use(Hookshot)",
            # Push the block, dive, hookshot the dragon's eye.
            "Water Temple Dragon Statue": "Progressive_Strength_Upgrade and can_use(Hookshot)",
            # The locked door at the foot of the central pillar is the only way in.
            "Water Temple Central Pillar": "water_keys(2)"
        }
    },
    {
        "region_name": "Water Temple South Basement",
        "dungeon": "Water Temple",
        "locations": {
            "Water Temple Compass Chest": "True",
            "Water Temple Behind Gate Pot 1": "True",
            "Water Temple Behind Gate Pot 2": "True",
            "Water Temple Behind Gate Pot 3": "True",
            "Water Temple Behind Gate Pot 4": "True",
